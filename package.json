{
  "name": "anonymous-chat",
  "version": "1.0.2",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client --lan --port 8081 --scheme whisperchat",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node --test --test-timeout=60000 test/integration/*.test.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "start:headless": "EXPO_UNSTABLE_HEADLESS=1 expo start --dev-client --lan --port 8081 --scheme whisperchat",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-screen-capture": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "qrcode-terminal": "0.11.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.4",
    "socket.io-parser": "^4.2.7",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@signalapp/libsignal-client": "0.105.1",
    "babel-preset-expo": "~57.0.0",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "postcss": "8.5.30",
    "shell-quote": "1.12.0",
    "uuid": "11.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.0"
    }
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "whisper-privacy"
        ]
      }
    }
  }
}
